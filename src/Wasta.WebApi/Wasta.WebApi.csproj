<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
      <UserSecretsId>wasta-webapi</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.19" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wasta.Application\Wasta.Application.csproj" />
    <ProjectReference Include="..\Wasta.Infrastructure\Wasta.Infrastructure.csproj" />
    <ProjectReference Include="..\Wasta.Ai\Wasta.Ai.csproj" />
    <ProjectReference Include="..\Wasta.CareerCoach\Wasta.CareerCoach.csproj" />
    <ProjectReference Include="..\Wasta.SupportChat\Wasta.SupportChat.csproj" />
  </ItemGroup>


  <!-- The modules keep their prompts and knowledge base as loose files so they
       can be corrected without a redeploy. Copy them next to the host so the
       default relative paths in configuration resolve at runtime. -->
  <ItemGroup>
    <None Include="..\Wasta.CareerCoach\Prompts\**\*.txt" Link="Prompts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Wasta.SupportChat\Prompts\**\*.txt" Link="Prompts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Wasta.SupportChat\Knowledge\**\*.md" Link="Knowledge\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
