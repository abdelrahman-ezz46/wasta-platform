<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>wasta-devhost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.19" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wasta.Ai\Wasta.Ai.csproj" />
    <ProjectReference Include="..\Wasta.CareerCoach\Wasta.CareerCoach.csproj" />
    <ProjectReference Include="..\Wasta.SupportChat\Wasta.SupportChat.csproj" />
  </ItemGroup>

  <!-- The libraries keep their prompts and knowledge base as loose files so
       they can be edited without a redeploy; copy them next to the host so
       the default relative paths in config resolve at runtime. -->
  <ItemGroup>
    <None Include="..\Wasta.CareerCoach\Prompts\**\*.txt" Link="Prompts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Wasta.SupportChat\Prompts\**\*.txt" Link="Prompts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Wasta.SupportChat\Knowledge\**\*.md" Link="Knowledge\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
