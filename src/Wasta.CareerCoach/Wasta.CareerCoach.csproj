<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.19" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!-- Npgsql 9.0.4 pulls EF Relational 9.0.1; pin it forward so the
         assembly versions unify and the build stays warning-free. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.19" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wasta.Ai\Wasta.Ai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Prompts\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
